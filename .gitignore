# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Профили pprof: генерируются бенчмарками по требованию, в репозитории не храним.
profiles/*.pprof

# Binaries
cmd/agent/main
cmd/agent/agent
cmd/server/main
cmd/server/server

# Dependency directories (remove the comment below to include it)
vendor/

# IDEs directories
.vscode
